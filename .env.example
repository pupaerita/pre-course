# ไฟล์ตัวอย่าง — ไม่มีค่าลับจริง commit ได้
# ของจริงให้ใส่ใน .env.local (ห้าม commit)

# ฐานข้อมูล Postgres (Neon) — กดปุ่ม Connect ในหน้าโปรเจกต์ Neon แล้วคัดลอก 2 ลิงก์
# DATABASE_URL = แบบ pooled (host มี -pooler) ใช้ตอนเว็บทำงาน
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# DIRECT_URL = แบบ direct (ไม่มี -pooler) ใช้ตอนสร้าง/อัปเดตตาราง
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Resend (ส่งอีเมลขอบคุณ) — ว่างไว้ได้ ระบบจะข้ามการส่งอีเมลโดยไม่พัง
RESEND_API_KEY=""
# ผู้ส่ง เช่น "นิลิน <hello@โดเมนของคุณ>"
# ทดสอบก่อนยืนยันโดเมน ใช้ "onboarding@resend.dev" (ส่งได้เฉพาะอีเมลเจ้าของบัญชี Resend)
EMAIL_FROM="onboarding@resend.dev"

# ผู้ดูแลระบบ (เฟส 3)
# รหัสผ่านเข้าหน้า /admin — ตั้งให้ยาวและเดายาก
ADMIN_PASSWORD=""
# กุญแจเซ็นคุกกี้ล็อกอิน — สุ่มข้อความยาว ๆ เช่นรัน: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ที่อยู่เว็บจริง (ใช้ใน sitemap) — ตั้งตอนขึ้นเว็บจริง
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
